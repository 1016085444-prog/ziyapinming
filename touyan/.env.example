# 复制为 .env 后修改（.env 不会进 git）。
# 大模型也可以直接在网页「设置」里配置，两种方式任选；这里设置的优先，网页上显示为只读。

# ── 大模型 API Key（用哪家填哪家）──────────────────────────────
DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=           # 通义千问（阿里云百炼）
# ZHIPU_API_KEY=               # 智谱 GLM
# MOONSHOT_API_KEY=            # Kimi
# MINIMAX_API_KEY=             # MiniMax
# SILICONFLOW_API_KEY=         # 硅基流动
# ANTHROPIC_API_KEY=           # Claude
# OPENAI_API_KEY=              # OpenAI
# GOOGLE_API_KEY=              # Gemini
# OPENROUTER_API_KEY=          # OpenRouter
# OPENAI_COMPATIBLE_API_KEY=   # 自定义 OpenAI 兼容接口（中转站、vLLM 等）

# 服务商与模型（不填则用网页设置，再不填用默认：DeepSeek）
# 可选：deepseek qwen glm kimi minimax siliconflow anthropic openai gemini openrouter ollama custom
# TOUYAN_LLM_PROVIDER=deepseek
# TOUYAN_QUICK_MODEL=deepseek-flash      # 分析师、研究员、交易员、风控（调用次数多）
# TOUYAN_DEEP_MODEL=deepseek-v4-pro      # 研究主管、投资经理（做最终判断）
# TOUYAN_BASE_URL=                       # 中转站 / 自建服务地址；Ollama 默认 http://localhost:11434/v1
# TOUYAN_CLAUDE_EFFORT=high              # Claude 推理强度：low medium high xhigh max

# ── 部署到服务器时必须设置 ────────────────────────────────────
# 不设置时，「深度分析」和「修改设置」只允许本机访问，防止别人刷你的大模型额度。
# APP_PASSWORD=

# ── 其他 ──────────────────────────────────────────────────────
# HOST=127.0.0.1                         # 服务器上改成 0.0.0.0
# PORT=8600
# TOUYAN_DATA_DIR=./data                 # 设置、历史记录、行情缓存的存放目录
# TOUYAN_MAX_JOBS=2                      # 同时进行的深度分析上限
# TOUYAN_DEBATE_ROUNDS=1                 # 多空辩论轮数 1–3
# TOUYAN_RISK_ROUNDS=1                   # 风控辩论轮数 1–3
# TOUYAN_RISK_FREE_RATE=2.0              # 无风险利率（%），算夏普比率用
# TOUYAN_KLINE_VENDORS=eastmoney,tencent,akshare,yfinance   # K 线数据源顺序
# HTTPS_PROXY=http://127.0.0.1:7890      # 访问国外模型（Claude、OpenAI、Gemini）时的代理
